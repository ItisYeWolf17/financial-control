# Copiá este archivo como .env.local y completá con los valores de tu proyecto Firebase.
# .env.local está en .gitignore — NO lo subas al repositorio.
#
# Console de Firebase → Configuración del proyecto → Tus apps → App web → Configuración del SDK.
# Estos valores viajan al navegador y no son secretos; la seguridad la dan las Security Rules,
# App Check y la restricción de la API key por dominio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3) — solo la site key pública. La secret key va en Google Cloud, nunca aquí.
VITE_RECAPTCHA_SITE_KEY=

# Usar los emuladores locales en desarrollo (true/false)
VITE_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# SECRETOS (no van en ningún archivo del repo, ni siquiera en .env.local):
#   FIREBASE_SERVICE_ACCOUNT  -> GitHub Actions → Settings → Secrets (deploys)
#   RECAPTCHA_SECRET_KEY      -> Google Cloud Console
# ---------------------------------------------------------------------------
